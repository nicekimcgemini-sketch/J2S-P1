# Supabase 프로젝트 설정
# Supabase 대시보드 → Project Settings → Database 에서 확인

# Transaction pooler (권장 - 서버리스 환경)
# 포트: 6543
SUPABASE_JDBC_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Session pooler (JPA/Hibernate 권장 - prepared statement 지원)
# 포트: 5432
# SUPABASE_JDBC_URL=jdbc:postgresql://db.[PROJECT_REF].supabase.co:5432/postgres

SUPABASE_DB_USER=postgres.[PROJECT_REF]
SUPABASE_DB_PASSWORD=your-supabase-db-password
